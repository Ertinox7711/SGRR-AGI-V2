{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "mcp__Claude_in_Chrome__navigate",
      "mcp__Claude_in_Chrome__computer",
      "mcp__Claude_in_Chrome__find",
      "mcp__Claude_in_Chrome__read_page",
      "mcp__Claude_in_Chrome__get_page_text",
      "mcp__Claude_in_Chrome__javascript_tool",
      "mcp__Claude_in_Chrome__read_console_messages",
      "mcp__Claude_in_Chrome__read_network_requests",
      "mcp__Claude_in_Chrome__form_input",
      "mcp__Claude_in_Chrome__tabs_create_mcp",
      "mcp__Claude_in_Chrome__tabs_close_mcp",
      "mcp__Claude_in_Chrome__tabs_context_mcp",
      "mcp__Claude_in_Chrome__select_browser",
      "mcp__Claude_in_Chrome__list_connected_browsers",
      "mcp__Claude_in_Chrome__browser_batch",
      "mcp__plugin_playwright_playwright__browser_navigate",
      "mcp__plugin_playwright_playwright__browser_navigate_back",
      "mcp__plugin_playwright_playwright__browser_snapshot",
      "mcp__plugin_playwright_playwright__browser_click",
      "mcp__plugin_playwright_playwright__browser_type",
      "mcp__plugin_playwright_playwright__browser_fill_form",
      "mcp__plugin_playwright_playwright__browser_press_key",
      "mcp__plugin_playwright_playwright__browser_hover",
      "mcp__plugin_playwright_playwright__browser_select_option",
      "mcp__plugin_playwright_playwright__browser_wait_for",
      "mcp__plugin_playwright_playwright__browser_evaluate",
      "mcp__plugin_playwright_playwright__browser_take_screenshot",
      "mcp__plugin_playwright_playwright__browser_tabs",
      "mcp__plugin_playwright_playwright__browser_console_messages",
      "mcp__plugin_playwright_playwright__browser_network_requests",
      "mcp__playwright"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)"
    ],
    "additionalDirectories": []
  },
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\caveman-statusline.ps1\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "firebase@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": false,
    "claude-mem@thedotmack": false,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\check-cc-updates.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\rig-audit-nudge.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\shopify-token-check.ps1\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_playwright_playwright__browser_navigate|mcp__Claude_in_Chrome__navigate|mcp__Claude_in_Chrome__tabs_create_mcp|mcp__Claude_in_Chrome__computer|mcp__Claude_in_Chrome__javascript_tool|mcp__plugin_playwright_playwright__browser_evaluate",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\browser-nav-denylist.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\protected-path-denylist.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\asset-delete-guard.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|mcp__.*(update-product|create-product|bulk-update-product-status|update-collection|create-collection|graphql_mutation|create-discount|set-inventory|switch-shop)",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\shop-identity-guard.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\shop-token-identity-block.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\destructive-block.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\pitfall-tips.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\pitfall-tips.ps1\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"__USERPROFILE__\\.claude\\scripts\\trio-fanout-cap.ps1\"",
            "timeout": 8
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "autoCompactWindow": 300000,
  "autoUpdatesChannel": "latest",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipWorkflowUsageWarning": true,
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright"
  ]
}
